# --- Keycard sign-in (copy to .env and fill in) ---

# Long random string. Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Admins (comma-separated). They can always sign in and open /auth/admin.
ADMIN_EMAILS=you@yourcompany.com

# Public address of Miti, used in email links.
APP_URL=http://localhost:3000

# Optional: link shown to people without access and in licence reminders.
CONTACT_URL=

# Email. Leave SMTP_HOST empty during setup: sign-in codes then print in the terminal.
# Microsoft 365: smtp.office365.com, port 587 (SMTP AUTH must be enabled for the mailbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Miti <noreply@yourcompany.com>
